# Copy this file to .env and fill in the values: cp .env.example .env
# Every script loads .env with python-dotenv. Variables already set in your
# shell win over .env (e.g. `LLM_PROVIDER=fake make run-all`).

# Which provider the examples use: google_genai (default), openai or fake.
# fake = offline: no API key, no cost, canned answers (great for a first run).
LLM_PROVIDER=google_genai

# Optional overrides (empty = the default of the chosen provider - see
# learning_langchain/config.py and REQUIREMENTS.md, section 5).
LLM_MODEL=
LLM_EMBEDDING_MODEL=
# Number between 0 and 2; empty = 0.5.
LLM_TEMPERATURE=

# Google AI Studio API key (LLM_PROVIDER=google_genai):
# https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API key (LLM_PROVIDER=openai):
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
